{
  "expo": {
    "name": "Moni",
    "slug": "budget",
    "version": "1.4.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1D9E75"
      },
      "notification": {
        "icon": "./assets/notification-icon.png",
        "color": "#1D9E75"
      },
      "package": "com.stanislavlas.moni",
      "versionCode": 17,
      "kotlinVersion": "2.0.21"
    },
    "platforms": [
      "android"
    ],
    "extra": {
      "eas": {
        "projectId": "413353e1-2fd3-4a86-b7dd-2a24df85d419"
      }
    },
    "plugins": [
      "expo-asset",
      "expo-secure-store",
      "expo-status-bar",
      "expo-notifications",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "resizeMode": "contain",
          "backgroundColor": "#1D9E75"
        }
      ],
      "@react-native-community/datetimepicker"
    ],
    "owner": "slas"
  }
}
